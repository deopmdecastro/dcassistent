# Variáveis usadas pelo docker-compose.yml (nível "infra", não segredos do
# gateway em si — esses ficam em dc-gateway/.env, copiado a partir de
# dc-gateway/.env.example).

# Porta exposta no host para o dc-gateway (dentro do container é sempre 4000)
GATEWAY_PORT=4000

# Porta exposta no host para a prévia visual do mockup (Echo Mind UI)
FRONTEND_PREVIEW_PORT=8080
