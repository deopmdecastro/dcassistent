# DC Gateway — variaveis de ambiente
# Copiar para .env e preencher com valores reais. NUNCA fazer commit do .env.

# ---- Core ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ---- Auth (device <-> gateway) ----
DEVICE_AUTH_SECRET=

# ---- AI Provider ----
# provider ativo: "anthropic" | "mock"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ---- Spotify ----
# provider ativo: "spotify" | "mock"
MUSIC_PROVIDER=mock
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:4000/api/music/spotify/callback

# ---- Calendar ----
# provider ativo: "google" | "mock"
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ---- Weather ----
# provider ativo: "openweather" | "mock"
WEATHER_PROVIDER=mock
WEATHER_API_KEY=

# ---- Calls ----
# provider ativo: "mock" (arquitetura preparada para VoIP futuro)
CALLS_PROVIDER=mock
