// Tema visual da DC — cores/tipografia/raios pensados para aproximar a
// identidade da versão Web (frontend-preview/index.html: fundo escuro,
// cartões arredondados, acento azul/ciano) dentro das limitações do
// ecrã embarcado (320x240, sem fontes web, renderer por software).
//
// Ajustar os valores de cor aqui se, ao comparar lado a lado com a Web,
// a identidade não bater certo — é o único sítio onde a paleta vive.

export global Theme {
    // --- Cores base ---
    out property <color> bg-root: #0f1117;
    out property <color> bg-surface: #171a23;
    out property <color> bg-surface-raised: #1f2330;
    out property <color> bg-tile: #232838;
    out property <color> bg-tile-pressed: #2c3245;

    out property <color> accent: #3ea6ff;
    out property <color> accent-soft: #3ea6ff33;
    out property <color> success: #3ecf8e;
    out property <color> warning: #f5a623;
    out property <color> danger: #ef4444;

    out property <color> text-primary: #f2f4f8;
    out property <color> text-secondary: #9aa3b5;
    out property <color> text-disabled: #5b6274;

    // --- Forma ---
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;

    // --- Tipografia (tamanhos pensados para 320x240 + touch) ---
    out property <length> font-xs: 10px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 18px;

    // --- Espaçamento ---
    out property <length> gap-sm: 4px;
    out property <length> gap-md: 8px;
    out property <length> gap-lg: 12px;

    // --- Alvo mínimo de toque (dedo adulto, ecrã pequeno) ---
    out property <length> touch-target-min: 44px;
}
